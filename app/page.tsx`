"use client";

import React, { useState, useMemo } from "react";
import menuData from "@/src/data/menu";
import PairingDrawer from "@/src/components/PairingDrawer";

interface Plate {
  id: string;
  nombre: string;
  categoria: string;
  precio: number;
  descripcion: string;
  maridaje: string;
  ocasion: string[];
  imagen: string;
}

export default function Page() {
  const [activeCategory, setActiveCategory] = useState("Todos");
  const [isDrawerOpen, setIsDrawerOpen] = useState(false);

  // Asegurar que menuData sea siempre un arreglo, extrayendo la clave raíz si existe
  const menu = useMemo(() => {
    if (!menuData) return [];
    if (Array.isArray(menuData)) return menuData as Plate[];
    if (typeof menuData === "object" && "menu" in menuData && Array.isArray((menuData as any).menu)) {
      return (menuData as any).menu as Plate[];
    }
    return [];
  }, [menuData]);

  const categories = ["Todos", "Entradas", "Platos Fuertes", "Postres"];

  const filteredMenu = useMemo(() => {
    const data = menu || [];
    if (activeCategory === "Todos") return data;
    return data.filter((item: Plate) => item.categoria === activeCategory);
  }, [activeCategory, menu]);

  return (
    <main className="relative min-h-screen overflow-x-hidden">
      {/* Hero Section */}
      <section className="relative w-full min-h-[85vh] flex flex-col items-center justify-center text-center px-4 overflow-hidden bg-[url('/images/hero-bg.webp')] bg-cover bg-center bg-no-repeat">
        <div className="absolute inset-0 bg-gradient-to-b from-black/80 via-black/60 to-[#080808]" />

        <div className="relative z-10 max-w-4xl flex flex-col items-center gap-6">
          <h1 className="font-syne text-5xl sm:text-7xl md:text-8xl font-bold tracking-tighter text-white">
            ALTITUD <span className="text-gold">2850</span>
          </h1>

          <p className="text-base sm:text-lg md:text-xl font-inter text-white/60 max-w-2xl tracking-wide">
            Cocina Neotradicional Quiteña & Maridaje Inteligente
          </p>

          <button
            onClick={() => setIsDrawerOpen(true)}
            className="group relative px-8 py-4 bg-gold text-black font-bold rounded-full transition-all duration-300 hover:scale-105 active:scale-95 overflow-hidden shadow-lg shadow-gold/20 my-2"
          >
            <span className="relative z-10">Maridar con IA</span>
            <div className="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300" />
            <div className="absolute -inset-1 bg-gold blur-lg opacity-30 group-hover:opacity-60 transition-opacity duration-300" />
          </button>
        </div>
      </section>

      {/* Menu Section */}
      <section className="max-w-7xl mx-auto px-4 pb-24">
        {/* Category Filters */}
        <div className="flex flex-wrap justify-center gap-3 mb-16">
          {categories.map((cat) => (
            <button
              key={cat}
              onClick={() => setActiveCategory(cat)}
              className={`px-6 py-2 rounded-full font-inter transition-all duration-300 border ${
                activeCategory === cat
                  ? "bg-gold text-black border-gold shadow-[0_0_15px_rgba(197,160,89,0.4)]"
                  : "bg-white/5 text-white/60 border-white/10 hover:bg-white/10 hover:text-white"
              }`}
            >
              {cat}
            </button>
          ))}
        </div>

        {/* Menu Grid */}
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {Array.isArray(filteredMenu) && filteredMenu.map((plate: Plate) => (
            <div
              key={plate.id}
              className="group relative backdrop-blur-md bg-white/5 border border-white/10 rounded-3xl overflow-hidden transition-all duration-500 hover:-translate-y-2 hover:border-gold/30"
            >
              <div className="relative h-64 overflow-hidden">
                <img
                  src={plate.imagen}
                  alt={plate.nombre}
                  className="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                />
                <div className="absolute top-4 left-4 flex gap-2">
                  <span className="px-3 py-1 rounded-full bg-black/60 backdrop-blur-md text-gold text-xs font-bold border border-gold/30 uppercase tracking-wider">
                    {plate.categoria}
                  </span>
                </div>
                <div className="absolute bottom-4 right-4">
                  <span className="px-4 py-2 rounded-full bg-gold text-black font-bold text-lg shadow-lg">
                    ${plate.precio}
                  </span>
                </div>
              </div>

              <div className="p-6">
                <h3 className="font-syne text-2xl font-semibold mb-2 group-hover:text-gold transition-colors duration-300">
                  {plate.nombre}
                </h3>
                <p className="font-inter text-white/60 text-sm leading-relaxed mb-6">
                  {plate.descripcion}
                </p>

                <div className="flex flex-wrap gap-2 mb-6">
                  {plate.ocasion?.map((tag: string) => (
                    <span key={tag} className="text-[10px] px-2 py-1 rounded-md bg-white/5 border border-white/10 text-white/40 uppercase font-medium">
                      {tag}
                    </span>
                  ))}
                </div>

                <div className="p-4 rounded-2xl bg-gold/5 border border-gold/10">
                  <p className="text-xs font-inter text-gold/80 uppercase tracking-widest mb-1 font-semibold">
                    Maridaje Recomendado
                  </p>
                  <p className="font-inter text-sm text-white/90 italic">
                    {plate.maridaje}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <PairingDrawer isOpen={isDrawerOpen} onClose={() => setIsDrawerOpen(false)} />
    </main>
  );
}
